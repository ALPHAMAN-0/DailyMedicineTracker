# Runtime env vars (set these in Vercel project settings for deployment,
# and in .env.local for local development).

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON key, with real newlines
# escaped as \n (this is how it looks when copy-pasted from the JSON file).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
APP_PASSCODE=
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Only needed locally, once, to run scripts/bootstrap-sheet.mjs.
# Not needed by the deployed app itself.
GOOGLE_SHEET_OWNER_EMAIL=
